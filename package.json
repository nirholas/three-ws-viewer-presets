		"readyplayerme-alternative",
		"visage-derived",
		"presets",
		"three-ws",
		"threejs",
		"ai-agents",
		"javascript",
		"esm",
		"zero-dependencies",
		"three-js"
	],
	"author": "three.ws <support@three.ws> (https://three.ws)",
	"license": "Apache-2.0",
	"homepage": "https://nirholas.github.io/three-ws-viewer-presets/",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/nirholas/three-ws-viewer-presets.git"
	},
	"type": "module",
	"main": "./src/index.js",
